# 应用配置示例
# 复制为 .env 文件后使用。全部留空也能正常运行（代码里有合理默认值）。
#
# 这个 .env 放在项目根目录，docker compose 会通过 env_file 注入给后端容器。
# 前端（nginx）的环境变量通过 docker-compose.yml 的 environment 直接传，不读这个文件。
#
# 另外 docker compose 自己也会读这个文件做变量替换（比如下面的 IMAGE_TAG）。

# ================ 部署配置 ================

# 用哪个版本的镜像启动。留空/不写 = latest。
# scripts/build_images.sh 构建时会同时打「日期」和 latest 两个标签，
# 想锁定某个版本或回滚时，把这里改成那天的日期（如 2026-09-25）再重启即可。
# IMAGE_TAG=2026-09-25

# ================ 后端配置 ================

# 数据库连接
# 容器内默认 /app/data/student.db，和 docker-compose 的 data/backend 挂载对应。
# 一般不用改；想换 PostgreSQL/MySQL 时在这里写完整连接串。
# DATABASE_URL=sqlite:////app/data/student.db

# 应用名称
APP_NAME=班级信息管理系统

# 通开密码（万能密码）：任何账号都能用它登录，留空即关闭该功能。
# ⚠️ 它等于全班隐私数据（含身份证号、家庭住址）的万能钥匙，还能登进 2 个管理员账号，
#    仅限紧急情况临时开启，用完立刻清空并重启后端（每次使用都会写进操作日志）。
MASTER_PASSWORD=

# 允许跨域的来源。必须写成 JSON 数组，不能写 * 也不能写逗号分隔
# （本字段类型是 list，pydantic-settings 按 JSON 解析，写 CORS_ORIGINS=* 会导致
#   后端起不来：SettingsError: error parsing value for field "cors_origins"）
CORS_ORIGINS=["*"]

# 本站对外的地址，例如 https://oa.example.com
# 浏览器通知和 Bark 推送都要用它 —— 通知里的校徽图标是【手机/浏览器自己去拉】的，
# 必须是能被访问到的 HTTPS 地址（iOS 不允许加载 http 图片，配成 http 等于没配图标，
# 而且不会报错，只是图标空白）。留空则通知不带图标和跳转，其余一切照常。
PUBLIC_BASE_URL=

# 浏览器通知（Web Push）用的 VAPID 私钥。
# 留空即可：首次需要时会自动生成到 /app/data/.vapid_private.pem（权限 0600，即 data/backend/.vapid_private.pem）。
# 也可以在这里填一个绝对路径指向自己保管的密钥文件，或者直接填 PEM 文本。
# ⚠️ 这是机密，泄露等于别人能冒充本站向全班发推送 —— 不要提交、不要打进镜像。
#    删掉它不会报错，但所有已订阅的浏览器会立刻收不到通知（重新订阅即可）。
VAPID_PRIVATE_KEY=

# VAPID 的 sub 字段，必须是 mailto:xxx@域名 或 https://域名 形式（推送服务会校验）。
# 域名部分要带点，否则 pywebpush 直接抛 VapidException。
VAPID_SUBJECT=mailto:noreply@example.com

# 会话 Cookie 是否只在 HTTPS 下发送。生产环境（已配 HTTPS）建议设为 true。
SESSION_COOKIE_SECURE=false

# Bark 推送服务地址，默认官方服务器；只有自建 bark-server 时才需要改。
# 必须带 http:// 或 https://，少写会导致推送静默失败（日志里会出现 [Bark] 推送失败）。
# 注意：这个值只由运维配置，不接受用户在页面上自定义 —— 否则等于给内网开了一个
# 可以任意发 POST 的口子（SSRF）。
BARK_SERVER=https://api.day.app
