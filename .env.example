# 应用配置示例
# 复制为 .env 文件后使用。全部留空也能正常运行（代码里有合理默认值）。
#
# 这个 .env 放在项目根目录，docker compose 会通过 env_file 注入给后端容器。
# 前端（nginx）的 NGINX_* 配置项通过 docker-compose.yml 的 environment 直接传，不读这个文件；
# 但文件末尾的 SITE_*（站点品牌）要读 —— 它们由 docker compose 插值后传给前端容器。
#
# 另外 docker compose 自己也会读这个文件做变量替换（比如下面的 IMAGE_TAG）。

# ================ 部署配置 ================

# 用哪个版本的镜像启动。留空/不写 = latest。
# scripts/build_images.sh --push 会同时打「日期」和 latest 两个标签，
# 想锁定某个版本或回滚时，把这里改成那天的日期（如 2026-09-25）再重启即可。
# 改完记得跟一次 docker compose pull：up -d 自己不会去 registry 查新版本，
# 本地已经缓存了同名镜像时会一直用缓存的那份。
# IMAGE_TAG=2026-09-25

# ================ 后端配置 ================

# 数据库连接
# 容器内默认 /app/data/student.db，和 docker-compose 的 data/backend 挂载对应。
# 一般不用改；想换 PostgreSQL/MySQL 时在这里写完整连接串。
# DATABASE_URL=sqlite:////app/data/student.db

# 后端应用名称。只影响 /docs 接口文档的标题、推送的分组名和几条后台提示语，
# **不影响页面上的班级名** —— 页面上显示什么看文件末尾的 SITE_NAME。
# 想让两处一致，把这两个设成同一个字符串即可。
APP_NAME=班级信息管理系统

# 通开密码（万能密码）：任何账号都能用它登录，留空即关闭该功能。
# ⚠️ 它等于全班隐私数据（含身份证号、家庭住址）的万能钥匙，还能登进 2 个管理员账号，
#    仅限紧急情况临时开启，用完立刻清空并重启后端。
#    用它登录不留任何痕迹（与本人登录完全一样），事后无法从日志里看出用过它。
#    建议同时配上 MASTER_PASSWORD_ALLOW_IPS 限制可用网段。
MASTER_PASSWORD=

# 允许跨域的来源。必须写成 JSON 数组，不能写 * 也不能写逗号分隔
# （本字段类型是 list，pydantic-settings 按 JSON 解析，写 CORS_ORIGINS=* 会导致
#   后端起不来：SettingsError: error parsing value for field "cors_origins"）
CORS_ORIGINS=["*"]

# 本站对外的地址，例如 https://oa.example.com
# 浏览器通知和 Bark 推送都要用它 —— 通知里的校徽图标是【手机/浏览器自己去拉】的，
# 必须是能被访问到的 HTTPS 地址（iOS 不允许加载 http 图片，配成 http 等于没配图标，
# 而且不会报错，只是图标空白）。留空则通知不带图标和跳转，其余一切照常。
PUBLIC_BASE_URL=

# 浏览器通知（Web Push）用的 VAPID 私钥。
# 留空即可：首次需要时会自动生成到 /app/data/.vapid_private.pem（权限 0600，即 data/backend/.vapid_private.pem）。
# 也可以在这里填一个绝对路径指向自己保管的密钥文件，或者直接填 PEM 文本。
# ⚠️ 这是机密，泄露等于别人能冒充本站向全班发推送 —— 不要提交、不要打进镜像。
#    删掉它不会报错，但所有已订阅的浏览器会立刻收不到通知（重新订阅即可）。
VAPID_PRIVATE_KEY=

# VAPID 的 sub 字段，必须是 mailto:xxx@域名 或 https://域名 形式（推送服务会校验）。
# 域名部分要带点，否则 pywebpush 直接抛 VapidException。
VAPID_SUBJECT=mailto:noreply@example.com

# 会话 Cookie 是否只在 HTTPS 下发送。生产环境（已配 HTTPS）建议设为 true。
SESSION_COOKIE_SECURE=false

# Bark 推送服务地址，默认官方服务器；只有自建 bark-server 时才需要改。
# 必须带 http:// 或 https://，少写会导致推送静默失败（日志里会出现 [Bark] 推送失败）。
# 注意：这个值只由运维配置，不接受用户在页面上自定义 —— 否则等于给内网开了一个
# 可以任意发 POST 的口子（SSRF）。
BARK_SERVER=https://api.day.app

# Cloudflare Turnstile 人机验证（可选）：配了就取代内置的算术验证码。
#
# 两个必须【成对】填：
#   - 都填齐 → 登录失败 1 次后显示 Turnstile 控件
#   - 只填一个 → 等于没配，退回内置算术验证码，启动日志里会有一行 [初始化] 提示
#                （只配一半多半是漏填，与其半死不活不如明确退回）
#   - 都留空 → 内置算术验证码（默认值，也是出问题时的退路）
#
# 去哪拿：Cloudflare 控制台 → Turnstile → Add widget。建的时候要把本站域名
# 加进允许列表（如 1.zdeweb.cn），否则控件会报域名不匹配。
#
# ⚠️ SECRET_KEY 是机密，和 MASTER_PASSWORD 同级：只放 .env，不提交、不进镜像。
#    SITE_KEY 相反，它要发给浏览器，本来就不是秘密。
#
# 关于内地网络：Turnstile 的脚本和校验接口都在 challenges.cloudflare.com。
# 服务器连不上校验接口时会【放行】并记一行 [Turnstile] 日志（可用性优先，不至于
# 全班登不进来）；用户的浏览器加载不出控件时会【自动退回算术验证码】。
# 真出问题又不想排查，把这两行清空重启即可回到算术验证码。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ================ 登录安全（IP 封禁 / 通开密码白名单）================

# 同一个 IP 在 LOGIN_FAIL_WINDOW_MINUTES 分钟内登录失败满多少次，就自动封禁它。
# 0 = 关闭自动封禁。改成负数没有意义，启动时会警告并按关闭处理。
#
# 两个参数和下面的可信代理网段是配套的：**IP 认错了，封禁就会封错人**。
# 上线后请按下面「怎么验证 IP 认对了」那一段核对一遍再依赖它。
LOGIN_BAN_THRESHOLD=20

# 失败计数的统计窗口（分钟）。验证码和自动封禁【共用】这一个数 ——
# 别指望给两者各配一个：计数会在较短的那个窗口先被清零，长窗口的阈值永远达不到。
LOGIN_FAIL_WINDOW_MINUTES=10

# 自动封禁多少分钟
LOGIN_BAN_MINUTES=60

# 可信反向代理的网段（逗号或空格分隔的 CIDR）。
#
# 只有请求的**直连来源**落在这里面时，后端才采信它带来的 X-Forwarded-For；
# 否则一律只看直连地址。这挡住的是「攻击者自己伪造 XFF 绕过封禁 / 冒充白名单 IP」。
#
# 默认值覆盖单机 Docker 下所有可能的容器 / 本机来源：
#   172.16.0.0/12  docker0（172.17/16）+ 用默认地址池建的全部 compose 网络
#   127.0.0.0/8    宿主机本地（network_mode: host、本机 nginx、本地开发）
#   ::1/128, fc00::/7, fe80::/10  IPv6 的本机 / 私有 / 链路本地段
# **故意不含 10.0.0.0/8 和 192.168.0.0/16**：那是局域网本身，信任它们等于
# 「局域网里任何人直连后端都能伪造 XFF」。Docker 默认也不拿这两段建容器网络。
# 要是你的 Docker 配了落在 10.x 的自定义地址池，把它加进来。
#
# 留空 = 谁也不信：X-Forwarded-For 一律不采信，所有请求看起来都来自代理 IP。
# 这时**自动封禁会自动关闭**（免得把全班封成同一个人），启动日志里会写明。
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.0/8,::1/128,fc00::/7,fe80::/10

# 允许使用通开密码（MASTER_PASSWORD）的 IP 网段（逗号或空格分隔的 CIDR）。
# 留空 = 不限制，任何 IP 都能用通开密码（也就是加这个功能之前的行为）。
# 配了就是白名单制：名单外的 IP 用通开密码登录会被当成「密码错误」。
#
# 通开密码是全班隐私数据（含身份证号、家庭住址）的万能钥匙，
# 只要它启用着，就建议顺手把这一行配上，例如：
#   MASTER_PASSWORD_ALLOW_IPS=203.0.113.7,10.8.0.0/24
MASTER_PASSWORD_ALLOW_IPS=

# ---------- 怎么验证 IP 认对了 ----------
# 这是上面前三个配置能否依赖的前提，上线后请核对一遍：
#   1. 用两台不同的设备（例如手机流量 + 家里 Wi-Fi）各登录一次
#   2. 进「系统管理 → 账号管理」，看这两行的「最近登录IP」
#   3. 应该是【两个不同的、看起来像运营商分配的公网地址】
# 如果全班所有人的 IP 都变成同一个 172.x / 127.x 之类的私网地址，
# 说明转发头没生效（多半是 TRUSTED_PROXIES 没覆盖实际那一段网络）——
# 此时自动封禁会把所有人当成同一个人，**一旦触发就全班登不进来**。
# 遇到这种情况先把 LOGIN_BAN_THRESHOLD 设成 0 关掉，再来排查。

# ================ 前端品牌 ================
# 站点标题上的班名、院系名、页脚署名、校徽，都能在服务器上改，不用重新构建镜像。
#
# 为什么是这里配、而不是构建时的变量：前端镜像由 GitHub Actions 预构建推到 GHCR，
# 服务器只 `docker compose pull`、不做构建 —— Vite 的构建期变量（VITE_*）在部署侧
# 根本不存在。所以品牌值只能是容器启动时注入：docker compose 把下面这几项插值后
# 传给前端容器，容器的启动脚本再写进 index.html / manifest.webmanifest / site-config.js。
#
# 改完怎么生效：docker compose up -d frontend
#   ⚠️ 用 restart 不生效 —— 环境变量在容器创建时就固定了，restart 不会重新注入。
#
# 三条写法约束：
#   - 值里不要出现 ' 和 \（会写坏 JS 字符串，启动脚本会拦下来并打一行 [品牌] 日志，
#     那一处显示为空白）
#   - 也不要出现 " < >（会写坏 HTML 属性）—— 只有 SITE_FOOTER 例外，见下面那一项
#   - 值里不要出现 $（docker compose 会在插值阶段就报错）
#
# 留空 = 页面上那一处显示为空白。这是有意的：空白一眼能看见，比悄悄用回某个
# 写死的旧值好排查。

# 站点全名：浏览器标签页标题、PWA 名称、顶栏主标题、登录页标题
SITE_NAME=统26-1班信息管理系统

# 班级简称：主屏图标下的名字、页面标题后缀、水印、首页欢迎语
SITE_SHORT_NAME=统26-1班

# 副标题：顶栏副标题、登录页副标题、首页副行、关于班级页
SITE_SUBTITLE=北方工业大学理学院统计学系

# 关于班级页的「所属学院」「所属专业」
SITE_COLLEGE=理学院
SITE_MAJOR=统计学

# 页脚署名（前面的 © 和年份由浏览器自动补，不用每年改）。
# 支持 HTML，可以放链接、换行等：
#   SITE_FOOTER=某某班委员会 · <a href="https://example.com">学院首页</a>
# 只有它放宽 —— 上面几个是纯文本，写了标签会被原样显示出来。
# 标签属性请用双引号，单引号会写坏生成的 JS 文件（下面「写法约束」里说的那条）。
SITE_FOOTER=北方工业大学理学院统26-1班委员会

# 搜索引擎看到的站点描述。留空则自动取上面的 SITE_NAME。
# 本站默认拒绝抓取（robots.txt + 页面上的 noindex），这一项基本用不上，一般不用填。
SITE_DESCRIPTION=

# ---------- 换校徽 / PWA 图标（也不用重建镜像）----------
# 把图放进 data/frontend/branding/，然后 docker compose restart frontend 即可：
#
#   branding/logo.png      顶栏、登录页、首页、关于班级页的校徽
#   branding/favicon.png   标签页图标（只放 logo.png 时，这一张跟着用 logo.png）
#   branding/icons/*.png   PWA 图标 4 张
#
# PWA 图标在容器里生成不了（nginx 镜像里没有 Pillow），要先在本机用新校徽生成好：
#   python3 scripts/make_pwa_icons.py <新校徽.png> data/frontend/branding/icons
#
# 删掉 branding/ 里的图再 restart，就会回到镜像内置的校徽。
#
# ⚠️ 已经「添加到主屏」的图标由手机系统在安装时快照，换图后不会自动更新，
#    要在手机上删掉图标重新添加。标签页图标偶尔也需要硬刷新（Cmd/Ctrl+Shift+R）。
